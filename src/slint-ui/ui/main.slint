import { ScrollView, ComboBox, SpinBox } from "std-widgets.slint";
import { Knob, Modulation } from "knob.slint";
export { Modulation } from "knob.slint";

export struct OscillatorState {
    waveform: int,
    pitch: float,
    fine: float,
    phase: float,
    phase-random: float,
    pulse-width: float,
    unison: float,
    detune: float,
    pan: float,
    level: float,
}

// Controlled input: gestures emit edits without severing backend value bindings.
component DepthSlider inherits Rectangle {
    in property <float> value;
    in property <string> label;
    in property <color> accent;
    callback edited(float);
    height: 24px;
    Rectangle { x: 8px; y: 10px; width: parent.width - 16px; height: 4px; background: #52616b; }
    Rectangle { x: parent.width / 2; y: 7px; width: 1px; height: 10px; background: #b4c5d0; }
    Rectangle { x: 8px + (root.value + 1) / 2 * (parent.width - 16px) - 6px; y: 6px; width: 12px; height: 12px; border-radius: 6px; background: root.accent; }
    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.edited(clamp((self.mouse-x - 8px) / max(self.width - 16px, 1px) * 2 - 1, -1, 1));
            }
        }
        moved => { if self.pressed { root.edited(clamp((self.mouse-x - 8px) / max(self.width - 16px, 1px) * 2 - 1, -1, 1)); } }
        double-clicked => { root.edited(0); }
    }
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value-minimum: -1;
    accessible-value-maximum: 1;
    accessible-value: root.value;
    accessible-action-increment => { root.edited(min(root.value + 0.01, 1)); }
    accessible-action-decrement => { root.edited(max(root.value - 0.01, -1)); }
    accessible-action-set-value(v) => { root.edited(clamp(v.to-float(), -1, 1)); }
}

component Action inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <color> accent: #a8b9c5;
    in property <bool> available: true;
    callback activated();
    min-width: 46px;
    height: 26px;
    background: root.selected ? root.accent.with-alpha(0.18) : hit.has-hover ? #363e46 : #292f36;
    border-color: root.selected ? root.accent : #414b54;
    border-width: 1px;
    border-radius: 3px;
    opacity: root.available ? 1 : 0.45;
    Text { text: root.text; color: root.selected ? root.accent : #c8d2d9; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    hit := TouchArea { enabled: root.available; mouse-cursor: pointer; clicked => { root.activated(); } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.available { root.activated(); } }
}

component Panel inherits Rectangle {
    background: #20262c;
    border-color: #48515a;
    border-width: 1px;
    border-radius: 4px;
}

component WaveGraph inherits Rectangle {
    in property <int> waveform;
    in property <float> phase;
    in property <float> cycles: 1;
    in property <float> pulse: 0.5;
    in property <color> trace: #b8e480;
    background: #10161b;
    border-width: 1px;
    border-color: #344049;
    clip: true;
    for line[index] in 9: Rectangle { x: index * (parent.width - 1px) / 8; width: 1px; height: parent.height; background: #202d35; }
    for line[index] in 5: Rectangle { y: index * (parent.height - 1px) / 4; height: 1px; width: parent.width; background: #202d35; }
    for sample[index] in 180: Rectangle {
        private property <float> p: mod(index / 179 * root.cycles + root.phase, 1);
        private property <float> v: root.waveform == 0 ? sin(self.p * 360deg) : root.waveform == 1 ? 1 - 4 * abs(self.p - 0.5) : root.waveform == 2 ? 2 * self.p - 1 : self.p < root.pulse ? 1 : -1;
        x: index / 179 * (parent.width - 3px);
        y: (1 - self.v) * (parent.height - 16px) / 2 + 7px;
        width: max(2px, parent.width / 179 + 1px); height: 2px;
        background: root.trace;
    }
}

component OscillatorCard inherits Panel {
    in property <int> number;
    in property <OscillatorState> state;
    callback edited(int, float);
    min-width: 242px;
    VerticalLayout {
        padding: 9px;
        spacing: 6px;
        HorizontalLayout {
            Text { text: "OSC 0\{root.number}"; color: #e6edf2; font-size: 15px; font-weight: 700; }
            Text { text: "ANALOG"; color: #a4b777; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 3px;
            for name[index] in ["SIN", "TRI", "SAW", "PULSE"]: Action {
                text: name; accent: #b8e480; selected: root.state.waveform == index;
                activated => { root.edited(0, index); }
            }
        }
        WaveGraph { height: 30px; waveform: root.state.waveform; phase: root.state.phase / 360; pulse: root.state.pulse-width / 100; }
        GridLayout {
            spacing: 4px;
            Knob { row: 0; col: 0; target: (root.number - 1) * 9; label: "SEMITONE"; unit: " st"; minimum: -48; maximum: 48; value: root.state.pitch; edited(v) => { root.edited(1, round(v)); } }
            Knob { row: 0; col: 1; target: (root.number - 1) * 9 + 1; label: "FINE"; unit: " ct"; minimum: -100; maximum: 100; value: root.state.fine; edited(v) => { root.edited(2, v); } }
            Knob { row: 0; col: 2; target: (root.number - 1) * 9 + 7; label: "PAN"; unit: "%"; minimum: -100; maximum: 100; value: root.state.pan; edited(v) => { root.edited(8, v); } }
            Knob { row: 1; col: 0; target: (root.number - 1) * 9 + 2; label: "PHASE"; unit: "°"; maximum: 360; value: root.state.phase; edited(v) => { root.edited(3, v); } }
            Knob { row: 1; col: 1; target: (root.number - 1) * 9 + 3; label: "PHASE RAND"; unit: "%"; value: root.state.phase-random; edited(v) => { root.edited(4, v); } }
            Knob { row: 1; col: 2; target: (root.number - 1) * 9 + 4; label: "PULSE WIDTH"; unit: "%"; minimum: 1; maximum: 99; default-value: 50; value: root.state.pulse-width; edited(v) => { root.edited(5, v); } }
            Knob { row: 2; col: 0; target: (root.number - 1) * 9 + 5; label: "UNISON"; unit: " v"; minimum: 1; maximum: 4; default-value: 1; value: root.state.unison; edited(v) => { root.edited(6, round(v)); } }
            Knob { row: 2; col: 1; target: (root.number - 1) * 9 + 6; label: "DETUNE"; unit: " ct"; value: root.state.detune; edited(v) => { root.edited(7, v); } }
            Knob { row: 2; col: 2; target: (root.number - 1) * 9 + 8; label: "LEVEL"; unit: "%"; default-value: 100; value: root.state.level; edited(v) => { root.edited(9, v); } }
        }
        Text { text: "Phase / rand: next note · Unison: whole voices"; color: #91a0ac; font-size: 9px; }
    }
}

component EnvelopeGraph inherits Rectangle {
    in property <float> attack;
    in property <float> decay;
    in property <float> sustain;
    in property <float> release;
    in property <color> trace: #53e2b4;
    private property <float> total: root.attack + root.decay + root.release + 0.3;
    background: #10191c;
    border-color: #304a44;
    border-width: 1px;
    for line[index] in 9: Rectangle { x: index * (parent.width - 1px) / 8; width: 1px; height: parent.height; background: #20332f; }
    for line[index] in 5: Rectangle { y: index * (parent.height - 1px) / 4; height: 1px; width: parent.width; background: #20332f; }
    Path {
        x: 7px; y: 7px; width: parent.width - 14px; height: parent.height - 14px;
        viewbox-width: 1000; viewbox-height: 100;
        stroke: root.trace; stroke-width: 2px;
        MoveTo { x: 0; y: 100; }
        LineTo { x: root.attack / root.total * 1000; y: 0; }
        LineTo { x: (root.attack + root.decay) / root.total * 1000; y: (1 - root.sustain) * 100; }
        LineTo { x: (root.attack + root.decay + 0.3) / root.total * 1000; y: (1 - root.sustain) * 100; }
        LineTo { x: 1000; y: 100; }
    }
}

component PianoKey inherits Rectangle {
    in property <string> label;
    in property <bool> sharp;
    in property <bool> active;
    in property <bool> available;
    callback played();
    background: root.active ? #53e2b4 : root.sharp ? #151c24 : #bdc8d0;
    border-width: 1px;
    border-color: #4b5b67;
    border-radius: 2px;
    opacity: root.available ? 1 : 0.45;
    Text { text: root.label; color: root.active ? #12382e : root.sharp ? #9badbb : #344552; font-size: 10px; horizontal-alignment: center; vertical-alignment: bottom; }
    TouchArea { enabled: root.available; clicked => { root.played(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { if root.available { root.played(); } }
}

export component MainWindow inherits Window {
    title: "PLASMA · Modulation Synthesizer";
    preferred-width: 1280px;
    preferred-height: 900px;
    min-width: 800px;
    min-height: 560px;
    background: #11161b;
    default-font-family: "Segoe UI";
    in property <[OscillatorState]> oscillators;
    in property <string> audio-status: "Starting audio…";
    in property <string> control-error;
    in property <bool> audio-ready: false;
    in property <[bool]> held-notes;
    in-out property <int> velocity: 127;
    in property <float> volume: 25;
    in property <[float]> globals: [0.01, 0.2, 0.7, 0.4, 1, 0, 18000, 0.1, 0.01, 0.2, 0.7, 0.4];
    in property <int> lfo-wave: 0;
    in property <bool> lfo-retrigger: true;
    in property <[float]> env-depths <=> Modulation.env-depths;
    in property <[float]> lfo-depths <=> Modulation.lfo-depths;
    in property <[float]> mod-env-depths <=> Modulation.mod-env-depths;
    in property <[float]> velocity-depths <=> Modulation.velocity-depths;
    in property <[float]> key-track-depths <=> Modulation.key-track-depths;
    in property <[float]> effective-values <=> Modulation.effective-values;
    in property <float> env-value;
    in property <float> lfo-value;
    in property <float> mod-env-value;
    in property <float> velocity-value;
    in property <float> key-track-value;
    callback parameter-edited(int, int, float);
    callback volume-edited(float);
    callback audition(int);
    callback stop();
    callback global-edited(int, float);
    callback lfo-wave-edited(int);
    callback lfo-retrigger-edited(bool);
    private property <[string]> destinations: ["OSC 1 · Semitone", "OSC 1 · Fine", "OSC 1 · Phase", "OSC 1 · Phase random", "OSC 1 · Pulse width", "OSC 1 · Unison", "OSC 1 · Detune", "OSC 1 · Pan", "OSC 1 · Level", "OSC 2 · Semitone", "OSC 2 · Fine", "OSC 2 · Phase", "OSC 2 · Phase random", "OSC 2 · Pulse width", "OSC 2 · Unison", "OSC 2 · Detune", "OSC 2 · Pan", "OSC 2 · Level", "OSC 3 · Semitone", "OSC 3 · Fine", "OSC 3 · Phase", "OSC 3 · Phase random", "OSC 3 · Pulse width", "OSC 3 · Unison", "OSC 3 · Detune", "OSC 3 · Pan", "OSC 3 · Level", "Master · Volume", "AMP ENV · Attack", "AMP ENV · Decay", "AMP ENV · Sustain", "AMP ENV · Release", "LFO · Rate", "LFO · Phase", "Filter · Cutoff", "Filter · Resonance", "MOD ENV · Attack", "MOD ENV · Decay", "MOD ENV · Sustain", "MOD ENV · Release"];

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            height: 42px;
            Text { text: "PLASMA"; color: #eef4f7; font-size: 27px; font-weight: 800; vertical-alignment: center; }
            Text { text: "MODULATION SYNTHESIZER  /  8 VOICES"; color: #788d9a; font-size: 10px; vertical-alignment: center; }
            Text { text: root.audio-ready ? "AUDIO ONLINE" : "AUDIO OFFLINE"; color: root.audio-ready ? #53e2b4 : #ffad88; horizontal-alignment: right; vertical-alignment: center; font-size: 11px; }
            Action { text: "STOP"; min-width: 70px; accent: #ffad88; activated => { root.stop(); } }
        }
        ScrollView {
            viewport-width: max(self.width, 1080px);
            VerticalLayout {
                padding-right: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    for oscillator[index] in root.oscillators: OscillatorCard {
                        number: index + 1; state: oscillator;
                        edited(field, value) => { root.parameter-edited(index, field, value); }
                    }
                    Panel {
                        min-width: 190px; max-width: 230px;
                        VerticalLayout {
                            padding: 10px; spacing: 8px;
                            Text { text: "FILTER / OUTPUT"; color: #e6edf2; font-size: 14px; font-weight: 700; }
                            Rectangle {
                                height: 80px; background: #11191f; clip: true;
                                for line[index] in 7: Rectangle { x: index * parent.width / 6; width: 1px; height: parent.height; background: #223039; }
                                Text { x: 8px; y: 7px; text: "LOW PASS"; font-size: 9px; color: #7f9bac; }
                                for sample[index] in 100: Rectangle {
                                    private property <float> f: 20 * pow(1000, index / 99);
                                    private property <float> response: 1 / sqrt(1 + pow(self.f / max(root.globals[6], 20), 4));
                                    x: index * (parent.width - 2px) / 99;
                                    y: 23px + (1 - self.response) * 45px;
                                    width: parent.width / 99 + 1px; height: 2px; background: #abc7df;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Knob { target: 34; label: "CUTOFF"; unit: " Hz"; minimum: 20; maximum: 20000; logarithmic: true; default-value: 18000; value: root.globals[6]; edited(v) => { root.global-edited(6, v); } }
                                Knob { target: 35; label: "RESONANCE"; maximum: 1; default-value: 0.1; value: root.globals[7]; edited(v) => { root.global-edited(7, v); } }
                            }
                            Rectangle { height: 1px; background: #414b54; }
                            Knob { target: 27; label: "MASTER"; unit: "%"; default-value: 25; value: root.volume; edited(v) => { root.volume-edited(v); } }
                            Text { text: "OSC MIX → FILTER → AMP\nAMP ENV shapes amplitude.\nMOD ENV is freely assignable."; color: #90a2ae; font-size: 10px; wrap: word-wrap; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Panel {
                        VerticalLayout {
                            padding: 10px; spacing: 7px;
                            HorizontalLayout {
                                Action { text: "AMP ENV / ASSIGN"; min-width: 130px; accent: #53e2b4; selected: Modulation.selected-source == 0; activated => { Modulation.selected-source = 0; } }
                                Text { text: "UNIPOLAR"; color: #7daca1; font-size: 9px; vertical-alignment: center; }
                                Rectangle { width: 72px; height: 6px; background: #121c1c; Rectangle { width: parent.width * clamp(root.env-value, 0, 1); height: parent.height; background: #53e2b4; } }
                            }
                            EnvelopeGraph { height: 50px; attack: root.globals[0]; decay: root.globals[1]; sustain: root.globals[2]; release: root.globals[3]; }
                            HorizontalLayout {
                                spacing: 4px;
                                Knob { target: 28; label: "ATTACK"; unit: " s"; minimum: 0.001; maximum: 10; logarithmic: true; default-value: 0.01; value: root.globals[0]; accent: #53e2b4; edited(v) => { root.global-edited(0, v); } }
                                Knob { target: 29; label: "DECAY"; unit: " s"; minimum: 0.001; maximum: 10; logarithmic: true; default-value: 0.2; value: root.globals[1]; accent: #53e2b4; edited(v) => { root.global-edited(1, v); } }
                                Knob { target: 30; label: "SUSTAIN"; maximum: 1; default-value: 0.7; value: root.globals[2]; accent: #53e2b4; edited(v) => { root.global-edited(2, v); } }
                                Knob { target: 31; label: "RELEASE"; unit: " s"; minimum: 0.001; maximum: 10; logarithmic: true; default-value: 0.4; value: root.globals[3]; accent: #53e2b4; edited(v) => { root.global-edited(3, v); } }
                            }
                            Text { text: "Shape preview · sustain hold shown as 300 ms"; color: #849c97; font-size: 9px; }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 10px; spacing: 7px;
                            HorizontalLayout {
                                Action { text: "MOD ENV / ASSIGN"; min-width: 130px; accent: #e6b66b; selected: Modulation.selected-source == 2; activated => { Modulation.selected-source = 2; } }
                                Text { text: "UNIPOLAR"; color: #bca47e; font-size: 9px; vertical-alignment: center; }
                                Rectangle { width: 72px; height: 6px; background: #231e17; Rectangle { width: parent.width * clamp(root.mod-env-value, 0, 1); height: parent.height; background: #e6b66b; } }
                            }
                            EnvelopeGraph { height: 50px; attack: root.globals[8]; decay: root.globals[9]; sustain: root.globals[10]; release: root.globals[11]; trace: #e6b66b; }
                            HorizontalLayout {
                                spacing: 4px;
                                Knob { target: 36; label: "ATTACK"; unit: " s"; minimum: 0.001; maximum: 10; logarithmic: true; default-value: 0.01; value: root.globals[8]; accent: #e6b66b; edited(v) => { root.global-edited(8, v); } }
                                Knob { target: 37; label: "DECAY"; unit: " s"; minimum: 0.001; maximum: 10; logarithmic: true; default-value: 0.2; value: root.globals[9]; accent: #e6b66b; edited(v) => { root.global-edited(9, v); } }
                                Knob { target: 38; label: "SUSTAIN"; maximum: 1; default-value: 0.7; value: root.globals[10]; accent: #e6b66b; edited(v) => { root.global-edited(10, v); } }
                                Knob { target: 39; label: "RELEASE"; unit: " s"; minimum: 0.001; maximum: 10; logarithmic: true; default-value: 0.4; value: root.globals[11]; accent: #e6b66b; edited(v) => { root.global-edited(11, v); } }
                            }
                            Text { text: "Independent shape · meter = live DSP output"; color: #bca47e; font-size: 9px; }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 10px; spacing: 7px;
                            HorizontalLayout {
                                Action { text: "LFO 1  /  ASSIGN"; min-width: 130px; accent: #659fff; selected: Modulation.selected-source == 1; activated => { Modulation.selected-source = 1; } }
                                Text { text: "BIPOLAR"; color: #8a9fba; font-size: 10px; vertical-alignment: center; }
                                Rectangle { width: 72px; height: 6px; background: #151c28; Rectangle { x: parent.width * (clamp(root.lfo-value, -1, 1) + 1) / 2 - 2px; width: 4px; height: parent.height; background: #659fff; } }
                            }
                            WaveGraph { height: 50px; waveform: root.lfo-wave; phase: root.globals[5]; cycles: root.globals[4]; trace: #659fff; }
                            HorizontalLayout {
                                spacing: 5px;
                                Knob { target: 32; label: "RATE"; unit: " Hz"; minimum: 0.01; maximum: 30; logarithmic: true; default-value: 1; value: root.globals[4]; accent: #659fff; edited(v) => { root.global-edited(4, v); } }
                                Knob { target: 33; label: "PHASE"; unit: " cyc"; maximum: 1; value: root.globals[5]; accent: #659fff; edited(v) => { root.global-edited(5, v); } }
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 3px;
                                        for name[index] in ["SIN", "TRI", "SAW", "SQR"]: Action { text: name; min-width: 35px; accent: #659fff; selected: root.lfo-wave == index; activated => { root.lfo-wave-edited(index); } }
                                    }
                                    Action { text: root.lfo-retrigger ? "RETRIGGER: ON" : "RETRIGGER: OFF"; accent: #659fff; selected: root.lfo-retrigger; activated => { root.lfo-retrigger-edited(!root.lfo-retrigger); } }
                                }
                            }
                            Text { text: "Source-control modulation uses prior DSP output"; color: #8498b0; font-size: 9px; }
                        }
                    }
                }
                Text { text: root.audio-status; color: root.audio-ready ? #89aea3 : #ffad88; font-size: 10px; wrap: word-wrap; }
                if root.control-error != "": Text { text: "Control error: " + root.control-error; color: #ffad88; font-size: 11px; wrap: word-wrap; }
            }
        }
        Panel {
            height: 132px;
            VerticalLayout {
                padding: 9px; spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    Action { text: "VELOCITY / ASSIGN"; min-width: 128px; accent: #e58dbe; selected: Modulation.selected-source == 3; activated => { Modulation.selected-source = 3; } }
                    Rectangle { width: 56px; height: 8px; background: #281c24; Rectangle { width: parent.width * clamp(root.velocity-value, 0, 1); height: parent.height; background: #e58dbe; } }
                    Action { text: "KEY TRACK / ASSIGN"; min-width: 140px; accent: #b5a0ff; selected: Modulation.selected-source == 4; activated => { Modulation.selected-source = 4; } }
                    Rectangle {
                        width: 56px; height: 8px; background: #211d2e;
                        Rectangle { x: (parent.width - 1px) / 2; width: 1px; height: parent.height; background: #70618b; }
                        Rectangle { x: (parent.width - self.width) * (clamp(root.key-track-value, -1, 1) + 1) / 2; width: 4px; height: parent.height; background: #b5a0ff; }
                    }
                    ComboBox { width: 168px; model: root.destinations; current-index: Modulation.selected-target; selected(value) => { Modulation.selected-target = self.current-index; } }
                    for name[source] in ["AMP", "LFO", "MOD", "VEL", "KEY"]: HorizontalLayout {
                        spacing: 3px;
                        Action { text: name; min-width: 36px; accent: source == 0 ? #53e2b4 : source == 1 ? #659fff : source == 2 ? #e6b66b : source == 3 ? #e58dbe : #b5a0ff; selected: Modulation.selected-source == source; activated => { Modulation.selected-source = source; } }
                        DepthSlider { width: 72px; value: root.depth(source); label: name + " modulation depth"; accent: source == 0 ? #53e2b4 : source == 1 ? #659fff : source == 2 ? #e6b66b : source == 3 ? #e58dbe : #b5a0ff; edited(v) => { Modulation.routed(Modulation.selected-target, source, v); } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "AUDITION  /  Click keys to latch · click again to release"; color: #a7bbc7; font-size: 10px; vertical-alignment: center; wrap: word-wrap; }
                    Text { text: "MIDI VELOCITY"; color: #a7bbc7; font-size: 10px; vertical-alignment: center; }
                    SpinBox {
                        width: 110px;
                        minimum: 1;
                        maximum: 127;
                        value <=> root.velocity;
                        accessible-label: "Audition velocity";
                    }
                    Text { text: "Vel=/127 · Key=(note-60)/60 at MIDI 60 · depth=normalized travel · Drag ↑↓ knobs"; color: #8294a0; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; wrap: word-wrap; }
                }
                Rectangle {
                    height: 49px;
                    for note[index] in [60, 62, 64, 65, 67, 69, 71, 72]: PianoKey {
                        x: index * parent.width / 8;
                        y: 0px;
                        width: parent.width / 8 - 2px; height: parent.height;
                        label: ["C4", "D", "E", "F", "G", "A", "B", "C5"][index];
                        active: root.held-notes[note - 60]; available: root.audio-ready;
                        played => { root.audition(note); }
                    }
                    for note[index] in [61, 63, 66, 68, 70]: PianoKey {
                        x: ([1, 2, 4, 5, 6][index] - 0.3) * parent.width / 8;
                        y: 0px;
                        width: parent.width / 8 * 0.6; height: 31px;
                        label: ["C♯", "D♯", "F♯", "G♯", "A♯"][index]; sharp: true;
                        active: root.held-notes[note - 60]; available: root.audio-ready;
                        played => { root.audition(note); }
                    }
                }
            }
        }
    }
    function depth(source: int) -> float { return source == 0 ? root.env-depths[Modulation.selected-target] : source == 1 ? root.lfo-depths[Modulation.selected-target] : source == 2 ? root.mod-env-depths[Modulation.selected-target] : source == 3 ? root.velocity-depths[Modulation.selected-target] : root.key-track-depths[Modulation.selected-target]; }
}
